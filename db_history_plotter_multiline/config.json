{
  "name": "DB History Plotter Multiline",
  "version": "2.0.0",
  "slug": "db_history_plotter_multiline",
  "description": "Queries HA DB and generates plots with multiple sensors per graph. Supports MariaDB and SQLite",
  "url": "https://github.com/tominowind/db_history_plotter_multiline",
  "arch": ["aarch64", "amd64", "armv7", "armhf", "i386"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "host_network": false,
  "map": [
    { "type": "homeassistant_config", "read_only": false, "path": "/homeassistant" },
    { "type": "media", "read_only": false }
  ],
  "ports": {},
  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },
  "options": {
    "db_type": "mariadb",
    "db_host": "core-mariadb",
    "db_name": "homeassistant",
    "db_user": "homeassistant",
    "sqlite_file": "/homeassistant/home-assistant_v2.db",
    "db_password": "",
    "timezone": "Europe/Berlin",
    "plots": []
  },
  "schema": {
    "db_type": "list(sqlite|mariadb)",
    "db_host": "str",
    "db_name": "str",
    "db_user": "str",
    "db_password": "str",
    "timezone": "str",
    "sqlite_file": "str",
    "plots": [
      {
        "plot_id": "str",
        "plot_title": "str",
        "hours_back": "int",
        "y_label": "str",
        "y_axis_position": "list(left|right)",
        "sensors": [
          {
            "sensor_id": "str",
            "label": "str",
            "color": "str?"
          }
        ]
      }
    ]
  }
}
